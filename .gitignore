# ★ CLOSED-SOURCE PROTECTION ★
# internal/ 目录包含 Polaris 独家核心技术：
#   5个技术壁垒源码 + 验证引擎 + 训练管线 + 加解密工具
#   .enc 文件和 protect_verify.js 可安全提交（无密钥无法解密）
#   .js 明文文件由构建时 npm run decrypt:verify 产生，不要提交！
internal/services/*.js
internal/.polaris_key
!internal/services/verification_engine.js.enc
!internal/scripts/protect_verify.js
