{
  "name": "polaris-agent",
  "version": "1.0.0",
  "description": "Polaris Solver — Optimization Research Agent",
  "author": "Bitwool <bitwool@163.com>",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"webpack serve --mode development --config config/webpack.config.js\" \"wait-on http://localhost:3000 && electron .\"",
    "build:renderer": "cross-env NODE_ENV=production webpack --mode production --config config/webpack.config.js",
    "build": "npm run build:renderer && electron-builder build --publish=never",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.bitwool.polaris-agent",
    "productName": "Polaris Solver",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**/*","build/**/*","icon.png","package.json"],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "icon.png",
      "artifactName": "Polaris-Solver-Windows.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icon.png",
      "artifactName": "Polaris-Solver-macOS.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png",
      "artifactName": "Polaris-Solver-Linux.${ext}",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Polaris Solver"
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "electron-log": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@reduxjs/toolkit": "^2.0.0",
    "autoprefixer": "^10.4.0",
    "babel-loader": "^9.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "css-loader": "^6.8.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.5.0",
    "postcss": "^8.4.0",
    "postcss-loader": "^7.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.0",
    "style-loader": "^3.3.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
